{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pip install -r requirements.txt && pip install -e ."
  },
  "deploy": {
    "startCommand": "make worker-run",
    "cronSchedule": "15 * * * *",
    "restartPolicyType": "NEVER"
  }
}
