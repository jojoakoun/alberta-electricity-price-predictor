{
  "name": "wattwise-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --signal SIGTERM --watch src --ext js,json --exec node src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "migrate": "dotenv -e ../../.env -- node-pg-migrate up --migrations-dir migrations",
    "migrate:down": "dotenv -e ../../.env -- node-pg-migrate down --migrations-dir migrations"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "jest": "^30.4.2",
    "node-pg-migrate": "^8.0.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "clearMocks": true
  }
}
