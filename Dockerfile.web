# -----------------------------------------------------------------------------
# Stage 1 - Build the React frontend
# -----------------------------------------------------------------------------
FROM node:22-bookworm-slim AS client-build

WORKDIR /build/client

COPY app/client/package*.json ./
RUN npm ci

COPY app/client/ ./
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 2 - Run the production API and serve the compiled frontend
# -----------------------------------------------------------------------------
FROM node:22-bookworm-slim AS production

WORKDIR /app/app/server

ENV NODE_ENV=production

COPY app/server/package*.json ./
RUN npm ci --omit=dev

COPY app/server/ ./

# Express expects the compiled frontend at /app/app/client/dist.
COPY --from=client-build /build/client/dist /app/app/client/dist

EXPOSE 8000

CMD ["npm", "start"]
