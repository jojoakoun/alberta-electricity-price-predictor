# Application
APP_ENV=development
LOG_LEVEL=INFO

# Project paths
DATA_DIR=data
RAW_DATA_DIR=data/raw
INTERIM_DATA_DIR=data/interim
PROCESSED_DATA_DIR=data/processed
MODEL_DIR=models
LOG_DIR=logs

# AESO API
# The subscription key is required by the operational worker.
AESO_API_BASE_URL=https://apimgw.aeso.ca/public/poolprice-api/v1.1
AESO_API_SUBSCRIPTION_KEY=

# API server
API_HOST=127.0.0.1
API_PORT=8000

# Web production
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
# Required by the production web service, migrations, historical seed, and worker.
DATABASE_URL=

# Production model release
# models/ is excluded from Git. In a clean production build, set both variables.
# MODEL_RELEASE_SHA256 must be the expected archive SHA-256 digest.
# Local omission is valid only when the complete active registry and all referenced
# model artifacts are already installed under MODEL_DIR.
MODEL_RELEASE_URL=
MODEL_RELEASE_SHA256=
